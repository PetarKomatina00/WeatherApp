# Ignore Rust build output
/target/

# Ignore Trunk build output (if using Trunk)
#/dist/          # Uncomment if you build to a dist/ directory
/.trunk-cache/

# Ignore Wasm-pack output (if using wasm-pack)
/pkg/

# Ignore generated WebAssembly and JavaScript artifacts (if built outside of pkg/)
*.wasm
*.js

# Ignore Node modules if you have any (e.g., for bundling or tooling)
/node_modules/

# OS-specific files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/

# Log files
*.log

.pp

Cargo.lock

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example

/dist/